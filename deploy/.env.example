# Which services to run: caddy (TLS on one domain, publishes 80/443) or tunnel (Cloudflare Tunnel, no open ports),
# plus upstream (the OF upstream from services/upstream). Drop ",upstream" to use an upstream outside this stack.
COMPOSE_PROFILES=caddy,upstream
# Public origin of the dashboard and API; feeds the Caddy site address, APP_URL and BETTER_AUTH_URL.
PUBLIC_URL=https://gw.example.com
# Postgres password for user "gateway": openssl rand -hex 24
POSTGRES_PASSWORD=
# Session/cookie signing secret (changing it logs everyone out): openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin of the upstream. The bundled one is http://upstream:8000; for another, e.g. https://upstream.example.com
# (path is ignored).
UPSTREAM_URL=http://upstream:8000
# Bearer token shared by the gateway and the upstream: openssl rand -hex 32
# Letters, digits and -._~ only, at least 16 characters (it also travels as a WebSocket subprotocol, so no base64).
UPSTREAM_TOKEN=
# The upstream's event socket. Empty = no events: no upstream webhooks, and /v1/ws answers 503.
UPSTREAM_WS_URL=ws://upstream:8000/ws
# Refuse to run an OF account without its own proxy, so the VPS IP never reaches OF.
# true = refuse accounts that have no proxy of their own; false (default) = accounts without one use the server IP
OF_REQUIRE_PROXY=false
# OF's static signing parameter. Empty = pass --static-param per account when connecting it.
STATIC_PARAM=
# Seconds between the upstream's polls of each account for messages.sent (OF's socket never sends an account's own
# messages): 10 to 86400, or 0 to turn messages.sent off. At most 13 OF requests per poll per account (about 390 an
# hour at 120).
# SENT_POLL_INTERVAL_S=120
# Seconds between the upstream's reads of each account's mass-message history for chat_queue.finished: 10 to 86400,
# or 0 to turn chat_queue.finished off. One OF request per poll per account (30 an hour at 120).
# MASS_POLL_INTERVAL_S=120
# Days of the event ledger behind /v1/stats.
EVENT_RETENTION_DAYS=365
# Set false once your own account exists, so strangers who find the URL cannot register (default true).
# REGISTRATION_OPEN=true
# Optional outgoing mail, used only for password reset. Empty SMTP_HOST = reset links are printed in
# `docker compose logs gateway`.
# Port 587 = STARTTLS (required), 465 = implicit TLS. SMTP_FROM_EMAIL defaults to SMTP_USER.
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=you@example.com
# SMTP_FROM_NAME=Gateway
# Timeout per upstream request, headers and body (default 30000).
# UPSTREAM_TIMEOUT_MS=30000
# Only for COMPOSE_PROFILES=tunnel,...: the token from the Cloudflare Zero Trust tunnel page.
# TUNNEL_TOKEN=
