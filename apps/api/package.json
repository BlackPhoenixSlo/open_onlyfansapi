{
  "name": "@gateway/api",
  "version": "2.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "auth:generate": "better-auth generate --config src/auth.ts --output src/db/auth-schema.ts -y",
    "link-team": "tsx --env-file-if-exists=../../.env src/db/link-team.ts",
    "analytics:claim": "tsx --env-file-if-exists=../../.env src/cli/analytics-claim.ts",
    "analytics:backfill": "tsx --env-file-if-exists=../../.env src/cli/analytics-backfill.ts",
    "analytics:diff": "tsx src/cli/analytics-diff.ts",
    "analytics:openers": "tsx --env-file-if-exists=../../.env src/cli/analytics-openers.ts",
    "analytics:rehash": "tsx --env-file-if-exists=../../.env src/cli/analytics-rehash.ts",
    "analytics:scripts": "tsx --env-file-if-exists=../../.env src/cli/analytics-scripts.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/websocket": "^11.3.1",
    "@scalar/fastify-api-reference": "^1.72.3",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
