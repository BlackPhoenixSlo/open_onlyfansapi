{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python -m pytest:*)",
      "Bash(codex exec:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(pnpm:*)",
      "Bash(npx vitest:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(curl:*)",
      "Bash(git worktree:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"agent: \" + (.agent.name // \"default\")'"
  }
}