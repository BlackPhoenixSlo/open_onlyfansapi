NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://gateway:gateway@localhost:5434/gateway
TEST_DATABASE_URL=postgres://gateway:gateway@localhost:5434/gateway_test
PORT=4000
APP_URL=http://localhost:5173          # dashboard origin: better-auth trusted origin, the only Origin allowed on cookie writes
BETTER_AUTH_URL=http://localhost:4000  # better-auth baseURL (where /api/auth is served)
BETTER_AUTH_SECRET=                    # openssl rand -base64 32
TRUST_PROXY=false                      # true when behind a reverse proxy
BACKEND_URL=http://localhost:3001
BACKEND_WS_URL=ws://localhost:3001
BACKEND_JWT_SECRET=                    # the backend's JWT_SECRET (which falls back to the backend's BETTER_AUTH_SECRET)
KEY_RATE_LIMIT_PER_MIN=120             # per API key (or dashboard user) on /v1
LOG_BODIES=errors                      # errors | all | none (slice 3)
LOG_BODY_MAX_BYTES=16384
LOG_RETENTION_DAYS=14
RUN_JOBS=true
