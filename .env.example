NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://gateway:gateway@localhost:5434/gateway
TEST_DATABASE_URL=postgres://gateway:gateway@localhost:5434/gateway_test  # shell env only: vitest does not read .env
PORT=4000
HOST=0.0.0.0                           # bind address
APP_URL=http://localhost:5173          # dashboard origin: better-auth trusted origin, the only Origin allowed on cookie writes
BETTER_AUTH_URL=http://localhost:4000  # better-auth baseURL (where /api/auth is served)
BETTER_AUTH_SECRET=                    # openssl rand -base64 32
TRUST_PROXY=false                      # behind a reverse proxy: hop count (1) or its IPs/CIDRs; true trusts every hop
UPSTREAM_URL=http://localhost:3001     # the upstream service's origin
UPSTREAM_TOKEN=                        # bearer token the gateway sends upstream (letters, digits, -._~ only: openssl rand -hex 32); dev-upstream-token with the fake upstream
UPSTREAM_TIMEOUT_MS=30000              # per upstream request (headers and body)
UPSTREAM_WS_URL=                       # the upstream's event socket, e.g. ws://localhost:8000/ws; empty = no events, /v1/ws answers 503
KEY_RATE_LIMIT_PER_MIN=120             # per API key (or dashboard user) on /v1
LOG_BODIES=errors                      # errors | all | none
LOG_BODY_MAX_BYTES=16384
LOG_RETENTION_DAYS=14
RUN_JOBS=true                          # retention jobs and the webhook delivery worker
ALLOW_HTTP_WEBHOOKS=false              # dev / trusted network only: allows http:// webhook URLs and also relaxes the private-host check
WEBHOOK_MAX_ATTEMPTS=6                 # attempts per delivery (retries after 30s, 2m, 10m, 1h, 6h)
WEBHOOK_PAUSE_AFTER=20                 # consecutive failed deliveries that pause an endpoint
WEBHOOK_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=365               # event ledger behind /v1/stats
