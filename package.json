{
  "name": "gateway",
  "version": "2.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @gateway/web build && pnpm --filter @gateway/api build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @gateway/api db:generate",
    "db:migrate": "pnpm --filter @gateway/api db:migrate",
    "media": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
